/*
 * Version resource for ext4.sys.
 *
 * Every value comes from include/version.h so the resource, the debug
 * banner and the control-device version query always agree. Numeric
 * constants are written out rather than pulled from <winver.h> so the file
 * compiles the same way whatever SDK the build machine has.
 */

/* version.h is UTF-8; preserve the author's name in the Unicode resource. */
#pragma code_page(65001)
#include "version.h"

1 VERSIONINFO
FILEVERSION    EXT4_VERSION_MAJOR, EXT4_VERSION_MINOR, EXT4_VERSION_PATCH, EXT4_VERSION_BUILD
PRODUCTVERSION EXT4_VERSION_MAJOR, EXT4_VERSION_MINOR, EXT4_VERSION_PATCH, EXT4_VERSION_BUILD
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L      /* VOS_NT_WINDOWS32 */
FILETYPE       0x3L          /* VFT_DRV          */
FILESUBTYPE    0x8L          /* VFT2_DRV_INSTALLABLE (file system driver) */
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      EXT4_COMPANY
            VALUE "FileDescription",  EXT4_PRODUCT_NAME
            VALUE "FileVersion",      EXT4_VERSION_STRING4
            VALUE "InternalName",     EXT4_DRIVER_FILE
            VALUE "LegalCopyright",   EXT4_COPYRIGHT
            VALUE "OriginalFilename", EXT4_DRIVER_FILE
            VALUE "ProductName",      "ext4"
            VALUE "ProductVersion",   EXT4_VERSION_STRING4
            VALUE "Comments",         EXT4_CONTACT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
