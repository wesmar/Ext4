/*
 * Version resource for ext4ctl.exe: the driver's version, from version.h.
 */

#include "version.h"

1 VERSIONINFO
FILEVERSION    EXT4_VERSION_MAJOR, EXT4_VERSION_MINOR, EXT4_VERSION_PATCH, EXT4_VERSION_BUILD
PRODUCTVERSION EXT4_VERSION_MAJOR, EXT4_VERSION_MINOR, EXT4_VERSION_PATCH, EXT4_VERSION_BUILD
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L      /* VOS_NT_WINDOWS32 */
FILETYPE       0x1L          /* VFT_APP */
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      EXT4_COMPANY
            VALUE "FileDescription",  "ext4ctl - LUKS volumes and ext4.sys control"
            VALUE "FileVersion",      EXT4_VERSION_STRING4
            VALUE "InternalName",     "ext4ctl.exe"
            VALUE "LegalCopyright",   EXT4_COPYRIGHT
            VALUE "OriginalFilename", "ext4ctl.exe"
            VALUE "ProductName",      "ext4"
            VALUE "ProductVersion",   EXT4_VERSION_STRING4
            VALUE "Comments",         EXT4_CONTACT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
